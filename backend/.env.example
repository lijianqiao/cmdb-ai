# 运行时简介：development | test | production
ENVIRONMENT=development
DEBUG=false

# PostgreSQL 运行时角色（仅限 DML）。对保留字符进行百分比编码。
DATABASE_URL=postgresql+psycopg://fastapi_admin_app:change-me@localhost:5432/fastapi_admin
# 仅将其注入生产中的一次性 Alembic 流程中。绝不暴露
# 长期运行的网络工作者的特权迁移凭证。
# MIGRATION_DATABASE_URL=postgresql+psycopg://fastapi_admin_migrator:change-me@localhost:5432/fastapi_admin
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Chat 模型：默认本地 llama.cpp，也可以指向任意 OpenAI 兼容厂商接口
# （DeepSeek、Moonshot/Kimi、智谱 GLM、阿里云 Qwen 兼容模式等）。
# 以下三项为数据库未配置该键时的启动兼容回退：
LLM_CHAT_BASE_URL=http://127.0.0.1:8080/v1
# LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=local-chat
# 按模型供应商当前价格填写；本地模型保持 0
LLM_CHAT_INPUT_COST_PER_MILLION_USD=0
LLM_CHAT_OUTPUT_COST_PER_MILLION_USD=0
# 换成主流厂商示例（以 DeepSeek 为例，把上面三行换成下面三行）：
# LLM_CHAT_BASE_URL=https://api.deepseek.com/v1
# LLM_CHAT_API_KEY=sk-your-deepseek-api-key
# LLM_CHAT_MODEL=deepseek-chat

# Embedding 模型：本地 llama.cpp 的 Qwen3-Embedding-0.6B，和 chat 相互独立配置。
# 以下三项为数据库未配置该键时的启动兼容回退：
LLM_EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=Qwen3-Embedding-0.6B

# 运维监控：TCP 探活 + CMDB 差异巡检（数据库未配置该键时的启动兼容回退）
MONITOR_PROBE_TIMEOUT_SECONDS=3.0
MONITOR_SWEEP_INTERVAL_SECONDS=30.0
CMDB_DIFF_INTERVAL_SECONDS=3600.0
MONITOR_EVENT_RETENTION_DAYS=7
# 设备命令两个超时量纲不同，不要用同一个值：
# CONN=建立 TCP 连接、认证、读 banner 的上限
# READ=单条命令等待提示符的上限，show running-config 这类大输出靠它兜底
DEVICE_COMMAND_CONN_TIMEOUT_SECONDS=15.0
DEVICE_COMMAND_READ_TIMEOUT_SECONDS=60.0

# 子 Agent Spawn 配额、关闭等待时间与终态回执回收周期
AGENT_MAX_CONCURRENT_CHILDREN=5
AGENT_MAX_SPAWN_DEPTH=2
AGENT_MAX_CHILDREN_PER_SESSION=50
AGENT_MAX_TOTAL_CHILD_COST_USD=5.0
AGENT_CHILD_MAX_STEPS=20
AGENT_CHILD_MAX_COST_USD=1.0
AGENT_CHILD_MAX_WALL_TIME_SECONDS=120.0
AGENT_CLOSE_TIMEOUT_SECONDS=5.0
AGENT_TERMINAL_RECEIPT_TTL_SECONDS=300.0
AGENT_RECEIPT_GC_INTERVAL_SECONDS=60.0

# 数据库可逆秘密值的共享 Fernet 密钥：同时保护 CMDB 静态密码和 LLM API Key。
# 泄露、丢失或轮换会同时影响两类密文；必须稳定备份，禁止与 JWT SECRET_KEY 混用。
# 在 backend/ 下生成：
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CMDB_CREDENTIAL_KEY=

# 在开发中，省略 SECRET_KEY 以在每个进程启动时使用临时密钥。
# 生产环境必须提供至少 32 个字符的加密随机值：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
ALGORITHM=HS256
JWT_ISSUER=fastapi-admin
JWT_AUDIENCE=fastapi-admin-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SESSION_REPLAY_GRACE_DAYS=1
REFRESH_SESSION_HISTORY_RETENTION_DAYS=30
REFRESH_SESSION_CLEANUP_BATCH_SIZE=1000

# 身份验证保护。仍然建议使用共享网关限制器
# 多进程或多实例生产部署。
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
PASSWORD_HASH_MAX_CONCURRENCY=4
PASSWORD_HASH_QUEUE_TIMEOUT_SECONDS=5
REGISTRATION_ENABLED=false

# 浏览器和反向代理策略。
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# 仅在调试 SQL 时设置 true；否则，使 sqlalchemy.engine 远离控制台。
SQL_ECHO=false
API_V1_PREFIX=/api/v1

# 一次性引导程序。在正常应用程序启动期间保持未设置。剧本
# 拒绝升级或覆盖现有帐户。
# INIT_SUPERUSER_USERNAME=admin
# INIT_SUPERUSER_EMAIL=admin@example.com
# INIT_SUPERUSER_PASSWORD=
